{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "onFailure": "block",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/block-push.sh\""
          },
          {
            "type": "command",
            "shell": "bash",
            "onFailure": "block",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/scripts/py-launch.sh\" block_push"
          },
          {
            "type": "command",
            "shell": "bash",
            "onFailure": "block",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.sh\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "onFailure": "block",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.sh\""
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "onFailure": "block",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/schema.sh\" wiki-conventions"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/schema.sh\" wiki-layout"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/sync-status.sh\""
          }
        ]
      }
    ]
  }
}
